# Sandbox-only variant of docker/ci/Dockerfile (see issue #628).
#
# Claude Code's remote/sandboxed sessions (claude.ai/code) route outbound
# HTTPS through a policy-enforcing proxy that TLS-intercepts with its own CA
# (/root/.ccr/ca-bundle.crt). Manjaro's `pacman -Syu` doesn't trust that CA by
# default, so it fails against the sandbox's proxy. Real CI (GitHub Actions)
# has no such proxy, so this variant is NOT used there — see
# docker/ci/Dockerfile for the plain image and scripts/dev-container.sh for
# the wrapper that builds this one.
#
# The CA bundle is supplied as an additional build context (never baked into
# the repo or a committed layer):
#
#   docker build --build-context cacerts=/root/.ccr \
#       -t storm-ci:sandbox -f docker/ci/Dockerfile.sandbox .
#
FROM manjarolinux/base:20260315

# Trust the sandbox proxy's CA before touching the network, so pacman's
# downloader accepts its TLS-intercepted responses.
COPY --from=cacerts ca-bundle.crt /etc/ca-certificates/trust-source/anchors/claude-code-agent-proxy.crt
RUN trust extract-compat

# System dependencies — kept identical to docker/ci/Dockerfile.
RUN pacman -Syu --noconfirm \
    && pacman -S --noconfirm --needed \
        cmake ninja gcc sqlite postgresql-libs \
        python python-yaml python-numpy python-scipy git valgrind lcov \
        github-cli jq \
    && pacman -Scc --noconfirm

# Prebuilt clang-p2996 from the sibling data-only image.
COPY --from=ghcr.io/spiritecosse/storm-clang:latest \
     /opt/clang-p2996 /opt/clang-p2996

# clang/clang++ symlinks (storm-clang ships clang-21 only).
RUN ln -s clang-21 /opt/clang-p2996/build/bin/clang \
    && ln -s clang-21 /opt/clang-p2996/build/bin/clang++

ENV LIBCXX_ROOT=/opt/clang-p2996 \
    PATH=/opt/clang-p2996/build/bin:$PATH

# Storm's CMakePresets.json references `${sourceDir}/../clang-p2996`. The
# entrypoint creates that symlink at $(dirname $PWD) on every container start,
# so the image works regardless of where the workspace is mounted.
COPY docker/ci/entrypoint.sh /usr/local/bin/storm-ci-entrypoint
RUN chmod +x /usr/local/bin/storm-ci-entrypoint

ENTRYPOINT ["/usr/local/bin/storm-ci-entrypoint"]
CMD ["bash"]
